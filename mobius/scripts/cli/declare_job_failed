#!/usr/bin/env bash
# declare_job_failed - mark a Mobius Session job failed and remove its running.flag.
set -euo pipefail

prog="$(basename "$0")"

usage() {
  cat <<USAGE
Usage: $prog <session_or_agent_id> <failure_reason...>

  Resolve a Mobius Session (by Mobius Session ID or backend Agent ID), write a
  failed.flag containing the reason, and remove that Session's running.flag.
  The operation is idempotent and replaces any previous failure record.

Options:
  -h, --help    show this help and exit

Environment:
  MOBIUS_BASE     backend base URL (required)
  MOBIUS_CLI_JWT  per-session CLI token minted by the Mobius session launcher

USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
if [[ $# -lt 2 || -z "$1" ]]; then
  usage >&2
  exit 2
fi

job_id="$1"
shift
reason="$*"
if [[ ! "$job_id" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]]; then
  echo "Input error: session_or_agent_id may contain only letters, digits, '_' and '-' (1-128 characters)" >&2
  exit 2
fi
if [[ -z "${reason//[[:space:]]/}" ]]; then
  echo "Input error: failure_reason must not be empty" >&2
  exit 2
fi

# 只走后端 API: 地址与令牌都来自会话环境 (宿主与沙箱同一条路)
# Backend API only: address and token come from the session environment
if [[ -z "${MOBIUS_BASE:-}" || -z "${MOBIUS_CLI_JWT:-}" ]]; then
  echo "Configuration error: MOBIUS_BASE and MOBIUS_CLI_JWT are required" >&2
  exit 3
fi
body="$(python3 -c 'import json,sys; print(json.dumps({"session_id": sys.argv[1], "status": "failed", "reason": sys.argv[2]}))' "$job_id" "$reason")"
tmp="$(mktemp)"
code="$(curl -sS --connect-timeout 5 --max-time 30 -o "$tmp" -w '%{http_code}' \
  -X POST "$MOBIUS_BASE/api/session-jobs/declare" \
  -H 'content-type: application/json' \
  -H "authorization: Bearer $MOBIUS_CLI_JWT" \
  --data-binary "$body" 2>/dev/null)" || {
  rm -f "$tmp"
  echo "Network error: cannot reach $MOBIUS_BASE" >&2
  exit 3
}
detail="$(cat "$tmp" 2>/dev/null || true)"
rm -f "$tmp"
if [[ "$code" == "200" ]]; then
  echo "Job declared failed: $job_id"
  exit 0
fi
echo "Backend error (HTTP $code): $detail" >&2
exit 5
