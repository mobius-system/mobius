#!/usr/bin/env bash
# multiagent_send - send a message through the Mobius multiagent API.
set -euo pipefail

BASE="${MOBIUS_BASE:-}"
prog="$(basename "$0")"

usage() {
  cat <<USAGE
Usage: $prog <self_id> <target_id> <content...>

  Send a message to a target Session after a bidirectional @ mention.

Options:
  -h, --help    show this help and exit

Environment:
  MOBIUS_BASE     backend base URL (required)
  MOBIUS_CLI_JWT  per-session CLI token minted by the Mobius session launcher
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
if [[ $# -lt 3 ]]; then
  usage >&2
  exit 2
fi

self_id="$1"
target_id="$2"
shift 2
content="$*"
if [[ -z "$content" ]]; then
  echo "Input error: content must not be empty" >&2
  exit 2
fi

if [[ -z "$BASE" ]]; then
  echo "Configuration error: MOBIUS_BASE is unset" >&2
  exit 3
fi
if [[ -z "${MOBIUS_CLI_JWT:-}" ]]; then
  echo "Configuration error: MOBIUS_CLI_JWT is unset" >&2
  exit 3
fi

token="$MOBIUS_CLI_JWT"

body="$(python3 -c 'import json,sys; print(json.dumps({"self_id": sys.argv[1], "target_id": sys.argv[2], "content": " ".join(sys.argv[3:])}))' "$self_id" "$target_id" "$content")"
resp="$(curl --silent --show-error --connect-timeout 5 --max-time 30 -w '\n%{http_code}' -X POST "$BASE/api/multiagent_communication" \
  -H "Authorization: Bearer $token" -H 'Content-Type: application/json' --data "$body")" || {
  echo "Network error: unable to connect to Mobius backend ($BASE)" >&2
  exit 5
}

http="${resp##*$'\n'}"
body_json="${resp%$'\n'*}"
err_from_json() { python3 -c 'import json,sys; print(json.load(sys.stdin).get("error", ""))' <<<"$1" 2>/dev/null || true; }
case "$http" in
  200)
    turn="$(python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("ok") is True; print(d.get("turn_number", "?"))' <<<"$body_json" 2>/dev/null || true)"
    if [[ -z "$turn" ]]; then
      echo "Protocol error: backend returned an invalid success response" >&2
      exit 6
    fi
    echo "Sent to Session $target_id (turn $turn)"
    ;;
  401) echo "Authentication error: JWT rejected by Mobius backend" >&2; exit 4 ;;
  403) echo "Permission error: $(err_from_json "$body_json" || echo denied)" >&2; exit 7 ;;
  404) echo "Link or Session error: $(err_from_json "$body_json" || echo not found)" >&2; exit 8 ;;
  410) echo "Link expired: $(err_from_json "$body_json" || echo expired)" >&2; exit 9 ;;
  413) echo "Input error: message is too large" >&2; exit 2 ;;
  *) echo "Backend error (HTTP $http): $(err_from_json "$body_json")" >&2; exit 10 ;;
esac
