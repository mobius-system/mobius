# Dependencies
node_modules/
# 这条不能合并到上面 (上面 node_modules/ 只匹配目录, 这是指向 frontend deps 的 symlink — 实际 v1.9 已替换为真目录, 保留兜底)
mobius/frontend/node_modules

# Build outputs
dist/
build/
# 例外: mobius/desktop/build/ 是桌面端构建期资源 (应用图标 icon.png/icon.ico +
# macOS entitlements.mac.plist), 干净 checkout 必须能拿到, 否则 CI/正式构建缺图标。
# git 规则: 父目录被忽略时无法直接反忽略其下文件, 必须先反忽略目录再反忽略文件。
!mobius/desktop/build/
!mobius/desktop/build/icon.png
!mobius/desktop/build/icon.ico
!mobius/desktop/build/entitlements.mac.plist
